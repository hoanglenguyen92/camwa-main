APP_DB_PASSWORD=
DATABASE_URL=postgresql+asyncpg://camwa:<APP_DB_PASSWORD>@localhost:5432/camwa
DB_ECHO=false
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600

# SMTP for the app's own emails. Keycloak uses the same values for set-password and reset emails.
MAIL_USERNAME=your-email
MAIL_PASSWORD=your smtp password
MAIL_FROM=your-email
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_STARTTLS=True
MAIL_SSL_TLS=False
USE_CREDENTIALS=True
EMAIL_RETRY_ATTEMPTS=3

# Keycloak. The backend is the only Keycloak client.
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=camwa
KEYCLOAK_CLIENT_ID=camwa-backend
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
KEYCLOAK_CLIENT_SECRET=

# docker-compose only
KC_DB_PASSWORD=
# Master-realm admin for the Keycloak console. Not a CAMWA account.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=

# First CAMWA admin, created by the realm import the first time Keycloak starts.
SEED_ADMIN_ID=1
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=

# Password for the demo accounts that `python seed.py --demo-users` creates. Local Keycloak only.
SEED_DEMO_PASSWORD=
